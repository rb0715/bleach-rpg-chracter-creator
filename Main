#Story Mode/Dungeon Selection 

story_m = input("Pick your Mission! (Save the Soul Society, Becoming A Soul Reaper, Bount Arc): ")

W = ["Save the Soul Society", "Becoming A Soul Reaper", "Bount Arc"]

while True:
    if story_m.lower == W[0] or story_m == W[0] or story_m.lower == W[2] or story_m == W[2]:
        print("Currently Locked")
        story_m = input("\nPick your Mission!:")
    elif story_m == W[1]:
        print("** star mission ")
        print("Selected!")
        break


    
